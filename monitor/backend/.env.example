# 감시 앱 환경 변수 예시 (실제 비밀값을 여기에 적지 않습니다)
# Neon 감시 DB 연결 설정 (일반 DB와 별개의 Neon 프로젝트/브랜치 사용)
# Neon 콘솔 > 프로젝트 > Connection Details > Pooled connection 값 사용
DB_HOST=your-neon-monitor-endpoint.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=YOUR_NEON_MONITOR_DB_PASSWORD
DB_SSLMODE=require

# 세션 암호화 키 (일반 앱과 다른 값으로 독립 설정)
SECRET_KEY=CHANGE_ME_TO_YOUR_OWN_RANDOM_SECRET

# 쿠키 보안 설정: 로컬 HTTP=false, Render HTTPS=true
SESSION_COOKIE_SECURE=false

# 일반↔감시 간 요청 검증 토큰 (일반 앱의 EVENT_TOKEN과 같은 값, 브라우저에 노출하지 않음)
EVENT_TOKEN=CHANGE_ME_TO_YOUR_OWN_EVENT_TOKEN

# Sentry 오류 수집 (https://sentry.io 에서 발급, 비워두면 Sentry 비활성화)
SENTRY_DSN=
SENTRY_ENVIRONMENT=mini-monitor
APP_VERSION=1.0.0
