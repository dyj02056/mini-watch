# Neon monitor DB. Keep real credentials in a local .env that is never committed.
DB_HOST=YOUR_MONITOR_POOLER.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=YOUR_NEON_MONITOR_PASSWORD
DB_SSLMODE=require
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_OF_32_CHARACTERS_OR_MORE
SESSION_COOKIE_SECURE=true
EVENT_TOKEN=CHANGE_ME_TO_THE_SAME_RANDOM_TOKEN_USED_BY_GENERAL
CLASSROOM_LOG_DIR=/classroom-logs
SEED_CLASSROOM_ACCOUNTS=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=mini-monitor
APP_VERSION=1.0.0
ENABLE_SENTRY_TEST=false
