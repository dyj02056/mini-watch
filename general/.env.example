# 일반 앱 환경 변수 예시 (실제 비밀값을 여기에 적지 않습니다)
# Neon 일반 DB 연결 설정
# Neon 콘솔 > 프로젝트 > Connection Details > Pooled connection 값 사용
DB_HOST=your-neon-project-endpoint.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=YOUR_NEON_DB_PASSWORD
DB_SSLMODE=require

# 세션 암호화 키 (32자 이상의 무작위 문자열로 직접 생성)
SECRET_KEY=CHANGE_ME_TO_YOUR_OWN_RANDOM_SECRET

# 쿠키 보안 설정: 로컬 HTTP=false, Render HTTPS=true
SESSION_COOKIE_SECURE=false

# 감시 Flask 주소 (Render 배포 후: https://your-monitor-api.onrender.com/api/events)
# 로컬 Compose 실행 시: http://monitor-api:5000/api/events
MONITOR_URL=http://monitor-api:5000/api/events

# 일반↔감시 간 요청 검증 토큰 (두 앱에 같은 값 사용, 브라우저에 노출하지 않음)
EVENT_TOKEN=CHANGE_ME_TO_YOUR_OWN_EVENT_TOKEN

# Sentry 오류 수집 (https://sentry.io 에서 발급, 비워두면 Sentry 비활성화)
SENTRY_DSN=
SENTRY_ENVIRONMENT=mini-general
APP_VERSION=1.0.0

# Sentry 실습 경로 활성화 여부 (확인 후 반드시 false로 되돌림)
ENABLE_SENTRY_TEST=false
